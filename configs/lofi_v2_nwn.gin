from __gin__ import dynamic_registration

import rave
from rave import core
from rave import blocks
from rave import discriminator
from rave import pqmf
from rave import dataset

import torch.nn as nn


# --- Core params (from v1.gin, without weight_norm) ---
SAMPLING_RATE = 44100
CAPACITY = 48
N_BAND = 16
LATENT_SIZE = 128
NOISE_AUGMENTATION = 0

KERNEL_SIZE = 3
DILATIONS = [
    [1, 3, 9],
    [1, 3, 9],
    [1, 3, 9],
    [1, 3],
]
RATIOS = [4, 2, 2, 2]

core.AudioDistanceV1.log_epsilon = 1e-7
core.AudioDistanceV1.multiscale_stft = @core.MultiScaleSTFT

core.MultiScaleSTFT:
    scales = [2048, 1024, 512, 256, 128]
    sample_rate = %SAMPLING_RATE
    magnitude = True

discriminator.ConvNet:
    in_size = 1
    out_size = 1
    capacity = %CAPACITY
    n_layers = 4
    stride = 4

discriminator.MultiScaleDiscriminator:
    n_discriminators = 3
    convnet = @spectral/discriminator.ConvNet

dataset.split_dataset.max_residual = 1000

core.get_augmented_latent_size:
    latent_size = %LATENT_SIZE
    noise_augmentation = %NOISE_AUGMENTATION

# No weight_norm — broken in PyTorch 2.6+
blocks.normalization.mode = 'identity'

# PQMF
pqmf.CachedPQMF:
    attenuation = 100
    n_band = %N_BAND

# ENCODER
blocks.EncoderV2:
    data_size = %N_BAND
    capacity = %CAPACITY
    ratios = %RATIOS
    latent_size = %LATENT_SIZE
    n_out = 2
    kernel_size = %KERNEL_SIZE
    dilations = %DILATIONS

blocks.VariationalEncoder:
    encoder = @variational/blocks.EncoderV2

blocks.NoiseGeneratorV2:
    hidden_size = 64
    data_size = %N_BAND
    ratios = [2, 2, 2]
    noise_bands = 32

# GENERATOR
blocks.GeneratorV2:
    data_size = %N_BAND
    capacity = %CAPACITY
    ratios = %RATIOS
    latent_size = @core.get_augmented_latent_size()
    kernel_size = %KERNEL_SIZE
    dilations = %DILATIONS
    amplitude_modulation = True
    noise_module = @blocks.NoiseGeneratorV2

# DISCRIMINATOR
periods/discriminator.ConvNet:
    conv = @nn.Conv2d
    kernel_size = (5, 1)

spectral/discriminator.ConvNet:
    conv = @nn.Conv1d
    kernel_size = 5
    stride = 2

discriminator.MultiPeriodDiscriminator:
    periods = [2, 3, 5, 7, 11]
    convnet = @periods/discriminator.ConvNet

discriminator.MultiScaleSpectralDiscriminator1d:
    scales = [4096, 2048, 1024, 512, 256]
    convnet = @spectral/discriminator.ConvNet

discriminator.CombineDiscriminators:
    discriminators = [
        @discriminator.MultiPeriodDiscriminator,
        @discriminator.MultiScaleDiscriminator,
    ]

feature_matching/core.mean_difference:
    relative = True

# RAVE
rave.RAVE:
    latent_size = %LATENT_SIZE
    pqmf = @pqmf.CachedPQMF
    sampling_rate = %SAMPLING_RATE
    encoder = @blocks.VariationalEncoder
    decoder = @blocks.GeneratorV2
    discriminator = @discriminator.CombineDiscriminators
    phase_1_duration = 1000000
    gan_loss = @core.hinge_gan
    feature_matching_fun = @feature_matching/core.mean_difference
    audio_distance = @core.AudioDistanceV1
    multiband_audio_distance = @core.AudioDistanceV1
    valid_signal_crop = True
    num_skipped_features = 1
    update_discriminator_every = 2
    weights = {
        'feature_matching': 20,
    }

rave.BetaWarmupCallback:
    initial_value = .01
    target_value = .01
    warmup_len = 300000
